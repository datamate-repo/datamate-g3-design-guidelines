{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Datamate G3 Typography Tokens",
  "fontFamily": "Poppins",
  "fallback": ["Helvetica Neue", "Arial", "sans-serif"],
  "scale": {
    "display": { "fontSize": 28, "fontWeight": 700, "letterSpacing": -0.5, "lineHeight": 1.2, "role": "Hero and splash titles" },
    "h1": { "fontSize": 22, "fontWeight": 700, "letterSpacing": -0.3, "lineHeight": 1.25, "role": "Primary screen title (Header Bar)" },
    "h2": { "fontSize": 18, "fontWeight": 700, "letterSpacing": -0.2, "lineHeight": 1.3, "role": "Section headers (Meta Section, Data Grid titles)" },
    "title": { "fontSize": 15, "fontWeight": 600, "letterSpacing": 0.1, "lineHeight": 1.35, "role": "Card titles, dialog headers" },
    "subtitle": { "fontSize": 14, "fontWeight": 500, "letterSpacing": 0, "lineHeight": 1.4, "role": "Sub-captions and context badges" },
    "body": { "fontSize": 13.5, "fontWeight": 500, "letterSpacing": 0, "lineHeight": 1.4, "role": "Table cell text, form input value, standard body" },
    "label": { "fontSize": 13, "fontWeight": 600, "letterSpacing": 0.2, "lineHeight": 1.3, "role": "Left-aligned input labels, button text" },
    "caption": { "fontSize": 12, "fontWeight": 500, "letterSpacing": 0, "lineHeight": 1.3, "role": "Context badges, table headers, metadata" },
    "helperItalic": { "fontSize": 11.5, "fontWeight": 400, "fontStyle": "italic", "letterSpacing": 0, "lineHeight": 1.25, "role": "4px sub-input balance indicators, auto-gen notices" }
  }
}
